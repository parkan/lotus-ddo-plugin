# Ethereum RPC endpoint (Lotus gateway or public)
RPC_URL=ws://localhost:1234/rpc/v1

# DDO contract 0x address
CONTRACT_ADDRESS=0x...

# Your miner actor ID (numeric, e.g. 1000)
PROVIDER_ID=1000

# Lotus full node API
LOTUS_API_URL=ws://localhost:1234/rpc/v1
LOTUS_API_TOKEN=eyJ...

# Lotus miner API
MINER_API_URL=ws://localhost:2345/rpc/v0
MINER_API_TOKEN=eyJ...

# DDO contract f4 address (f410f...)
DDO_CONTRACT_F4=f410f...

# Optional: polling interval (default: 30s)
# POLL_INTERVAL=30s

# Optional: block to start scanning from (default: latest)
# START_BLOCK=latest

# Optional: temp directory for downloaded pieces (default: ./downloads)
# DOWNLOAD_DIR=./downloads

# Optional: epochs after chain head for deal start (default: 5760 = ~2 days)
# START_EPOCH_BUFFER=5760

# Optional: epochs after chain head for deal end (default: 1152000 = ~400 days)
# END_EPOCH_BUFFER=1152000

# Optional: comma-separated 0x client addresses to accept allocations from.
# Unset/empty = accept any client (original behavior). When set, only allocations
# whose event.client matches one of the listed addresses are processed. Also
# pushed to eth_getLogs Topics[1] so the RPC node pre-filters.
# CLIENT_ALLOWLIST=0xabc...,0xdef...

# Optional: reject pieces smaller than this many bytes (padded size). 0 = no bound.
# MIN_PIECE_SIZE=0

# Optional: reject pieces larger than this many bytes (padded size). 0 = no bound.
# e.g. 34359738368 = 32 GiB padded
# MAX_PIECE_SIZE=0

# Optional: reject allocations with term_max above this many epochs. 0 = no bound.
# e.g. 1555200 = ~540 days
# MAX_TERM_MAX=0
